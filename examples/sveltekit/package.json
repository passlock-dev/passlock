{
	"name": "@passlock/sveltekit-example",
	"description": "SvelteKit app making full use of passkeys along with email based one time login codes",
	"private": true,
	"version": "2.5.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"sync": "svelte-kit sync || echo ''",
		"db:push": "drizzle-kit push --force",
		"reset": "vite-node --options.transformMode.ssr='/.*/' src/reset.ts",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "prettier --write . && eslint --fix .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@clack/prompts": "^1.4.0",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.16.0",
		"@passlock/browser": "workspace:^",
		"@passlock/server": "workspace:^",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "4.3.0",
		"@types/node": "^25.9.1",
		"daisyui": "^5.5.20",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.55.9",
		"svelte-check": "^4.4.8",
		"sveltekit-superforms": "^2.30.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4",
		"valibot": "^1.4.0",
		"vite": "^8.0.13",
		"vite-node": "^6.0.0"
	},
	"dependencies": {
		"@libsql/client": "^0.17.3"
	},
	"files": [
		"build",
		"package.json"
	]
}
