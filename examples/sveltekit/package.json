{
	"name": "@passlock/sveltekit-example",
	"version": "2.9.3",
	"private": true,
	"description": "SvelteKit app making full use of passkeys along with email based one time login codes",
	"type": "module",
	"files": [
		"build",
		"package.json"
	],
	"scripts": {
		"build": "vite build",
		"db:push": "drizzle-kit push --force",
		"dev": "vite dev",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "prettier --write . && eslint --fix .",
		"preview": "vite preview",
		"reset": "vite-node --options.transformMode.ssr='/.*/' src/reset.ts",
		"sort-package-json": "sort-package-json",
		"sync": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@libsql/client": "^0.17.4"
	},
	"devDependencies": {
		"@clack/prompts": "^1.6.0",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.21.0",
		"@passlock/browser": "^2.9.3",
		"@passlock/server": "^2.9.3",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.68.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "4.3.1",
		"@types/node": "^24.1.0",
		"daisyui": "^5.6.2",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"prettier": "^3.8.5",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"sort-package-json": "catalog:",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"sveltekit-superforms": "^2.30.1",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.0",
		"valibot": "^1.4.1",
		"vite": "^8.0.16",
		"vite-node": "^6.0.0"
	},
	"packageManager": "pnpm@11.9.0"
}
