{
  "name": "@passlock/sveltekit-example",
  "version": "2.6.0",
  "private": true,
  "description": "SvelteKit app making full use of passkeys along with email based one time login codes",
  "type": "module",
  "files": [
    "build",
    "package.json"
  ],
  "scripts": {
    "build": "vite build",
    "db:push": "drizzle-kit push --force",
    "dev": "vite dev",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint --fix .",
    "preview": "vite preview",
    "reset": "vite-node --options.transformMode.ssr='/.*/' src/reset.ts",
    "sort-package-json": "sort-package-json",
    "sync": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3"
  },
  "devDependencies": {
    "@clack/prompts": "^1.5.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@lucide/svelte": "^1.17.0",
    "@passlock/browser": "workspace:^2.6.0",
    "@passlock/server": "workspace:^2.6.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "^25.9.2",
    "daisyui": "^5.5.23",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sort-package-json": "catalog:",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "sveltekit-superforms": "^2.30.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "valibot": "^1.4.1",
    "vite": "^8.0.16",
    "vite-node": "^6.0.0"
  },
  "packageManager": "pnpm@11.5.2"
}
