{
  "name": "@passlock/browser",
  "version": "2.9.3",
  "description": "Flexible passkey authentication for Astro, SvelteKit, NextJS and other frameworks",
  "keywords": [
    "passkey",
    "webauthn",
    "astro",
    "svelte",
    "sveltekit",
    "react",
    "next",
    "vue",
    "nuxt"
  ],
  "homepage": "https://passlock.dev",
  "bugs": {
    "url": "https://github.com/passlock-dev/passlock/issues",
    "email": "team@passlock.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/passlock-dev/passlock.git",
    "directory": "packages/browser"
  },
  "license": "MIT",
  "author": {
    "name": "Toby Hobson",
    "email": "toby@passlock.dev"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:clean": "$npm_execpath run clean:all && $npm_execpath run build",
    "build:production": "$npm_execpath run build:clean && $npm_execpath run build:readme && $npm_execpath run replaceTokens && echo '' && publint",
    "build:readme": "VERSION=${npm_package_version} tsx ../../scripts/replace-readme-tokens.ts ./packages/browser",
    "clean": "tsc -p tsconfig.json --clean",
    "clean:all": "rimraf dist tsconfig.tsbuildinfo",
    "format": "biome format --fix .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check --fix .",
    "prepublishOnly": "$npm_execpath run build:production",
    "replaceTokens": "VERSION=${npm_package_version} tsx ../../scripts/replace-tokens.ts ./packages/browser",
    "sort-package-json": "sort-package-json",
    "test:all": "vitest --project unit --project integration run",
    "test:integration": "vitest --project integration run",
    "test:smoke": "$npm_execpath run test:smoke:deno && $npm_execpath run test:smoke:bun",
    "test:smoke:bun": "$npm_execpath run build && bun smoke/runtime.js",
    "test:smoke:deno": "$npm_execpath run build && deno run --allow-read --no-lock --import-map=smoke/deno.import-map.json smoke/runtime.js",
    "test:unit": "vitest --project unit run",
    "test:unit:watch": "vitest --project unit",
    "typecheck": "tsc -p tsconfig.test.json",
    "typedoc": "typedoc"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@effect/language-service": "^0.86.2",
    "@fetch-mock/vitest": "^0.2.18",
    "@typescript/lib-dom": "npm:@types/web@^0.0.350",
    "globals": "catalog:",
    "npm-check-updates": "catalog:",
    "publint": "catalog:",
    "rimraf": "catalog:",
    "sort-package-json": "catalog:",
    "tsx": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.9.0"
}
